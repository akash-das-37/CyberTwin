{
  "manifest_version": 3,
  "name": "CyberTwin AI",
  "version": "1.0.0",
  "description": "Privacy-first AI cybersecurity twin — your personal digital trust guardian against phishing and social engineering.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "CyberTwin AI"
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["logo.png", "icons/*", "assets/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
